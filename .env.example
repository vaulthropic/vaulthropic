# Sanitized placeholders for local deployment only.
# Copy this file to .env and replace the placeholders on the operator machine.
# .env and .env.* are gitignored. This example is the only env file allowed in Git.
# Do not put a real private key, a seed phrase, a tokenized RPC URL, or an
# unverified payTo or contract address in this file.
# The deployer key is a wallet you control. Vaulthropic never holds it.

DEPLOYER_PRIVATE_KEY=replace-with-local-hex-key
BASE_SEPOLIA_RPC_URL=https://example.invalid/base-sepolia
BASE_RPC_URL=https://example.invalid/base
ETHERSCAN_API_KEY=replace-with-local-api-key
